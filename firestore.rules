rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Ping check endpoint for client online test
    match /test/connection {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRecord(data) {
      return data.workerUid is string && data.workerUid.size() >= 1 && data.workerUid.size() <= 128
        && data.workerUid == request.auth.uid
        && (!('workerEmail' in data) || (data.workerEmail is string && data.workerEmail.size() <= 150))
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150
        && data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 50
        && data.programs is list && data.programs.size() <= 10
        && data.isNewConvert is bool
        && data.respondedWell is bool
        && data.evangelistName is string && data.evangelistName.size() >= 1 && data.evangelistName.size() <= 150
        && data.date is string && data.date.size() <= 25
        && data.followedUp is bool
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2500))
        && (!('followUpNotes' in data) || (data.followUpNotes is string && data.followUpNotes.size() <= 3000));
    }

    match /records/{recordId} {
      // Workers can only read and list records that belong to them
      allow get: if isSignedIn() && existing().workerUid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.workerUid == request.auth.uid;

      // Workers can only create records under their own authenticated UID
      allow create: if isSignedIn() && isValidId(recordId) && isValidRecord(incoming()) && incoming().workerUid == request.auth.uid;

      // Workers can only update their own records and cannot transfer ownership to another UID
      allow update: if isSignedIn() && isValidId(recordId) && isValidRecord(incoming())
        && existing().workerUid == request.auth.uid
        && incoming().workerUid == existing().workerUid;

      // Workers can only delete their own records
      allow delete: if isSignedIn() && isValidId(recordId) && existing().workerUid == request.auth.uid;
    }
  }
}
